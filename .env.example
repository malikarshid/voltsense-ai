# ==============================================================================
# VoltSense AI — Root Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT commit real secrets to version control.
# Copy this file to .env for local testing or configure in Vercel Project Settings.

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js 14)
# ------------------------------------------------------------------------------
# In production on Vercel with shared routing, use /api/v1 (relative path).
# In local standalone development without proxy, use http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# In production on Vercel, leave empty to automatically derive wss:// from host.
# In local development with separate ports, use ws://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=

# Backend server address for Next.js internal server-side rewrites
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=3000
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI Python Service)
# ------------------------------------------------------------------------------
PROJECT_NAME="VoltSense AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Generate a 256-bit secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_with_a_secure_random_production_secret_key_minimum_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Managed PostgreSQL (Neon / Supabase / AWS RDS)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=require
# Local SQLite default:
DATABASE_URL="sqlite+aiosqlite:///./voltsense.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://voltsense_user:password@ep-db.region.neon.tech/voltsense?ssl=require"

# PostgreSQL Serverless Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# CORS Whitelist (JSON array of allowed origins)
CORS_ORIGINS=["https://*.vercel.app","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Physics Simulator Loop
SIMULATION_INTERVAL_SEC=1.0
SIMULATION_MODE_DEFAULT=true

# MQTT Hardware Ingestion (Internal / On-Premise Only)
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX="voltsense"
