# ==============================================================================
# VoltSense AI — Backend Environment Template (.env.example)
# ==============================================================================
# Copy this file to backend/.env and configure your production values.
# DO NOT commit backend/.env with production credentials to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME METADATA
# ------------------------------------------------------------------------------
PROJECT_NAME="VoltSense AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 256-bit key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_with_a_secure_random_production_secret_key_minimum_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (DUAL-ENGINE ORM)
# ------------------------------------------------------------------------------
# Production Managed PostgreSQL (Neon / Supabase / AWS RDS):
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=require
# DATABASE_URL="postgresql+asyncpg://voltsense_user:password@ep-db.region.neon.tech/voltsense?ssl=require"
#
# Local / Container SQLite default:
DATABASE_URL="sqlite+aiosqlite:///./voltsense.db"

# ------------------------------------------------------------------------------
# 4. DATABASE CONNECTION POOLING (Enterprise & Serverless Tuning)
# ------------------------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS) POLICY
# ------------------------------------------------------------------------------
CORS_ORIGINS=["https://*.vercel.app","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 6. CAN-BMS PHYSICS SIMULATOR & TELEMETRY ENGINE
# ------------------------------------------------------------------------------
SIMULATION_INTERVAL_SEC=1.0
SIMULATION_MODE_DEFAULT=true

# ------------------------------------------------------------------------------
# 7. MQTT TELEMETRY INGESTION (Internal / Hardware Bus)
# ------------------------------------------------------------------------------
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX="voltsense"
