# ==============================================================================
# VoltSense AI — Frontend Environment Template (.env.example)
# ==============================================================================
# Copy this file to frontend/.env or configure in Vercel Project Settings.
# Security Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# ------------------------------------------------------------------------------
# 1. API & BACKEND ROUTING
# ------------------------------------------------------------------------------
# In production on Vercel with shared routing, use /api/v1 (relative path).
# In standalone local development without proxy, use http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Backend server address for Next.js internal server-side rewrites (SSR / edge proxy).
BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. REAL-TIME CAN-BMS WEBSOCKET TELEMETRY
# ------------------------------------------------------------------------------
# In production on Vercel / HTTPS, leave empty to automatically derive wss:// from host.
# In local development with separate ports, use ws://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=

# ------------------------------------------------------------------------------
# 3. NODE & NEXT.JS RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
